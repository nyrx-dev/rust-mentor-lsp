# ==============================================================================
# Rust Mentor LSP Configuration
# ==============================================================================
# Copy this file to `.env` in your project root or place it at:
#   ~/.config/rust-mentor/.env
# ==============================================================================

# Required: Google Gemini API Key for explanations and refactor synthesis.
# Get a key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: TypeSafe AI Jev API Key for neural decision-making & error filtering.
# When omitted, rust-mentor-lsp falls back to its built-in rule filter.
# TYPESAFE_API_KEY=your_typesafe_api_key_here

# Optional: Comma-separated list of additional rustc error codes you want Rust Mentor to handle.
# Built-in: E0106, E0277, E0373, E0382, E0499, E0502, E0503, E0505, E0506, E0507, E0515, E0521, E0596, E0597, E0716
# Example (add mismatched types and missing trait methods):
# RUST_MENTOR_EXTRA_ERROR_CODES=E0308,E0599,E0004

